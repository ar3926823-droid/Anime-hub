<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OtakuTrack - Personal Anime Dashboard</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://jsdelivr.net"></script>
  <!-- Google Fonts & Lucide Icons -->
  <link rel="preconnect" href="https://googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com"></script>
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #4b5563;
      border-radius: 3px;
    }
  </style>
</head>
<body class="bg-[#0b0f19] text-gray-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

  <!-- Navigation Bar -->
  <nav class="border-b border-gray-800 bg-[#0f172a]/80 backdrop-blur-md sticky top-0 z-50 px-4 lg:px-8 py-4">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="bg-gradient-to-tr from-indigo-500 to-violet-500 p-2 rounded-xl shadow-lg shadow-indigo-500/20">
          <i data-lucide="tv" class="w-6 h-6 text-white"></i>
        </div>
        <div>
          <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-indigo-400 to-violet-400 bg-clip-text text-transparent">OtakuTrack</span>
          <span class="text-xs block text-gray-400 font-medium">Your Ultimate Anime Counter</span>
        </div>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button id="openModalBtn" class="w-full sm:w-auto flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2.5 rounded-xl font-semibold shadow-lg shadow-indigo-600/20 transition-all active:scale-[0.98]">
          <i data-lucide="plus" class="w-4 h-4"></i> Add New Anime
        </button>
      </div>
    </div>
  </nav>

  <!-- Main Content Layout -->
  <main class="flex-grow max-w-7xl w-full mx-auto p-4 lg:p-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left Column: Statistics & Quick Insights -->
    <div class="space-y-6 lg:col-span-1">
      <!-- Stats Summary Card -->
      <div class="bg-[#111827] border border-gray-800/60 rounded-2xl p-6 shadow-xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/5 rounded-full blur-3xl pointer-events-none"></div>
        <h2 class="text-lg font-bold text-gray-200 mb-4 flex items-center gap-2">
          <i data-lucide="bar-chart-3" class="w-5 h-5 text-indigo-400"></i> Lifetime Metrics
        </h2>
        
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-[#1f2937]/50 border border-gray-800 p-4 rounded-xl">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Anime</p>
            <p id="statTotalCount" class="text-3xl font-extrabold text-white mt-1">0</p>
          </div>
          <div class="bg-[#1f2937]/50 border border-gray-800 p-4 rounded-xl">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Episodes</p>
            <p id="statTotalEpisodes" class="text-3xl font-extrabold text-white mt-1">0</p>
          </div>
        </div>

        <!-- Watch Time Breakdown -->
        <div class="mt-4 bg-gradient-to-r from-indigo-950/40 to-slate-900 border border-indigo-900/30 p-4 rounded-xl">
          <p class="text-xs font-semibold text-indigo-300 uppercase tracking-wider flex items-center gap-1.5">
            <i data-lucide="clock" class="w-3.5 h-3.5"></i> Time Spent Watching
          </p>
          <div class="grid grid-cols-3 gap-2 mt-2 text-center">
            <div>
              <p id="timeDays" class="text-xl font-bold text-white">0</p>
              <p class="text-[10px] text-gray-400 font-medium uppercase">Days</p>
            </div>
            <div>
              <p id="timeHours" class="text-xl font-bold text-white">0</p>
              <p class="text-[10px] text-gray-400 font-medium uppercase">Hours</p>
            </div>
            <div>
              <p id="timeMins" class="text-xl font-bold text-white">0</p>
              <p class="text-[10px] text-gray-400 font-medium uppercase">Mins</p>
            </div>
          </div>
        </div>

        <!-- Average Rating -->
        <div class="mt-4 flex items-center justify-between bg-[#1f2937]/30 border border-gray-800 p-3.5 rounded-xl">
          <span class="text-sm text-gray-400 font-medium">Mean Score</span>
          <div class="flex items-center gap-1.5">
            <i data-lucide="star" class="w-4 h-4 text-amber-400 fill-amber-400"></i>
            <span id="statAvgRating" class="text-base font-bold text-white">0.0</span>
            <span class="text-xs text-gray-500">/10</span>
          </div>
        </div>
      </div>

      <!-- Status Categorization Tracker -->
      <div class="bg-[#111827] border border-gray-800/60 rounded-2xl p-6 shadow-xl">
        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Status Distribution</h3>
        <div class="space-y-3">
          <!-- Watching -->
          <div>
            <div class="flex justify-between text-xs font-medium mb-1">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Watching</span>
              <span id="countWatching" class="font-bold">0</span>
            </div>
            <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
              <div id="barWatching" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
          <!-- Completed -->
          <div>
            <div class="flex justify-between text-xs font-medium mb-1">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span> Completed</span>
              <span id="countCompleted" class="font-bold">0</span>
            </div>
            <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
              <div id="barCompleted" class="bg-indigo-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
          <!-- Plan to Watch -->
          <div>
            <div class="flex justify-between text-xs font-medium mb-1">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Plan to Watch</span>
              <span id="countPlanToWatch" class="font-bold">0</span>
            </div>
            <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
              <div id="barPlanToWatch" class="bg-amber-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
          <!-- On Hold / Dropped -->
          <div>
            <div class="flex justify-between text-xs font-medium mb-1">
              <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> On Hold / Dropped</span>
              <span id="countOnHold" class="font-bold">0</span>
            </div>
            <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
              <div id="barOnHold" class="bg-rose-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Anime List & Filter Architecture -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Search & Filters Strip -->
      <div class="bg-[#111827] border border-gray-800/60 rounded-2xl p-4 flex flex-col md:flex-row gap-4 items-center justify-between shadow-xl">
        <div class="relative w-full md:w-72">
          <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500"></i>
          <input type="text" id="searchInput" placeholder="Search your catalog..." class="w-full pl-10 pr-4 py-2 bg-[#1f2937]/60 border border-gray-800 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 placeholder-gray-500 transition-all">
        </div>
        
        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center gap-1.5 w-full md:w-auto overflow-x-auto custom-scrollbar pb-1 md:pb-0">
          <button data-filter="all" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap bg-indigo-600 text-white shadow-sm shadow-indigo-600/10">All</button>
          <button data-filter="watching" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-400 hover:bg-[#1f2937] hover:text-gray-200">Watching</button>
          <button data-filter="completed" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-400 hover:bg-[#1f2937] hover:text-gray-200">Completed</button>
          <button data-filter="plan" class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-400 hover:bg-[#1f2937] hover:text-gray-200">Plan to Watch</button>
        </div>
      </div>

      <!-- Main Anime Table Container -->
      <div class="bg-[#111827] border border-gray-800/60 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full border-collapse text-left text-sm">
            <thead>
